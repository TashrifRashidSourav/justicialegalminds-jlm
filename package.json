{
    "name": "justicialegalminds",
    "version": "1.0.0",
    "description": "Justicia Legal Minds - Express.js Application",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node src/server.ts",
        "build": "tsc && npm run build:css",
        "build:css": "npx tailwindcss -i ./src/styles/input.css -o ./public/css/style.css --minify",
        "start": "node dist/server.js",
        "watch": "tsc -w"
    },
    "keywords": [
        "express",
        "legal",
        "law-firm"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "express": "^4.18.2",
        "ejs": "^3.1.9",
        "mysql2": "^3.6.5",
        "dotenv": "^16.3.1",
        "body-parser": "^1.20.2",
        "compression": "^1.7.4",
        "helmet": "^7.1.0",
        "cors": "^2.8.5"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "typescript": "^5",
        "ts-node": "^10.9.2",
        "tailwindcss": "^3.4.1",
        "autoprefixer": "^10",
        "postcss": "^8"
    }
}