        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "ejs": "^3.1.9",
        "express": "^4.18.2",
        "express-mysql-session": "^3.0.3",
        "express-session": "^1.17.3",
        "helmet": "^7.1.0",
        "multer": "^1.4.5-lts.1",
