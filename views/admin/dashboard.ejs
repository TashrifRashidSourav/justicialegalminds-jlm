<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - Admin
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: #f8f9fa;
        }

        .sidebar {
            min-height: 100vh;
            background: #212529;
        }

        .sidebar a {
            color: #adb5bd;
            padding: 10px 20px;
            display: block;
            text-decoration: none;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #343a40;
            color: #fff;
        }

        .main-content {
            padding: 20px;
        }
    </style>
</head>

<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-md-block sidebar">
                <div class="p-3">
                    <h5 class="text-white">Admin Panel</h5>
                    <p class="text-muted small">Welcome, <%= user.username %>
                    </p>
                </div>
                <div>
                    <a href="/admin/dashboard" class="active"><i class="fas fa-home"></i> Dashboard</a>
                    <a href="/admin/services"><i class="fas fa-briefcase"></i> Services</a>
                    <a href="/admin/team"><i class="fas fa-users"></i> Team</a>
                    <a href="/admin/inquiries"><i class="fas fa-envelope"></i> Inquiries</a>
                    <a href="/admin/settings"><i class="fas fa-cog"></i> Website Settings</a>
                    <hr class="bg-secondary">
                    <a href="/"><i class="fas fa-globe"></i> View Website</a>
                    <a href="/admin/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
                </div>
            </nav>

            <main class="col-md-10 ms-sm-auto main-content">
                <% if (success && success.length> 0) { %>
                    <div class="alert alert-success alert-dismissible fade show">
                        <%= success %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% } %>
                        <% if (error && error.length> 0) { %>
                            <div class="alert alert-danger alert-dismissible fade show">
                                <%= error %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                            <% } %>

                                <h2>
                                    <%= title %>
                                </h2>

                                <div class="row mt-4">
                                    <div class="col-md-3">
                                        <div class="card text-center">
                                            <div class="card-body">
                                                <h3>
                                                    <%= stats.services %>
                                                </h3>
                                                <p class="text-muted">Services</p>
                                                <a href="/admin/services" class="btn btn-sm btn-primary">Manage</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card text-center">
                                            <div class="card-body">
                                                <h3>
                                                    <%= stats.team %>
                                                </h3>
                                                <p class="text-muted">Team Members</p>
                                                <a href="/admin/team" class="btn btn-sm btn-primary">Manage</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card text-center">
                                            <div class="card-body">
                                                <h3>
                                                    <%= stats.inquiries %>
                                                </h3>
                                                <p class="text-muted">Total Inquiries</p>
                                                <a href="/admin/inquiries" class="btn btn-sm btn-primary">View</a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card text-center bg-warning">
                                            <div class="card-body">
                                                <h3>
                                                    <%= stats.unread %>
                                                </h3>
                                                <p class="text-muted">Unread</p>
                                                <a href="/admin/inquiries" class="btn btn-sm btn-dark">View</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card mt-4">
                                    <div class="card-header">
                                        <h5>Recent Inquiries</h5>
                                    </div>
                                    <div class="card-body">
                                        <% if (recentInquiries.length===0) { %>
                                            <p class="text-muted">No inquiries yet</p>
                                            <% } else { %>
                                                <table class="table">
                                                    <thead>
                                                        <tr>
                                                            <th>Name</th>
                                                            <th>Email</th>
                                                            <th>Subject</th>
                                                            <th>Date</th>
                                                            <th>Status</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% recentInquiries.forEach(inquiry=> { %>
                                                            <tr>
                                                                <td>
                                                                    <%= inquiry.name %>
                                                                </td>
                                                                <td>
                                                                    <%= inquiry.email %>
                                                                </td>
                                                                <td>
                                                                    <%= inquiry.subject || 'N/A' %>
                                                                </td>
                                                                <td>
                                                                    <%= new
                                                                        Date(inquiry.created_at).toLocaleDateString() %>
                                                                </td>
                                                                <td>
                                                                    <% if (inquiry.is_read) { %>
                                                                        <span class="badge bg-secondary">Read</span>
                                                                        <% } else { %>
                                                                            <span class="badge bg-warning">Unread</span>
                                                                            <% } %>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                    </tbody>
                                                </table>
                                                <% } %>
                                    </div>
                                </div>
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>