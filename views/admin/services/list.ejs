<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - Admin
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: #f8f9fa;
        }

        .sidebar {
            min-height: 100vh;
            background: #212529;
            position: fixed;
            width: 250px;
        }

        .sidebar a {
            color: #adb5bd;
            padding: 10px 20px;
            display: block;
            text-decoration: none;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #343a40;
            color: #fff;
        }

        .main-content {
            margin-left: 250px;
            padding: 20px;
        }
    </style>
</head>

<body>
    <nav class="sidebar">
        <div class="p-3">
            <h5 class="text-white">Admin Panel</h5>
            <p class="text-muted small">Welcome, admin</p>
        </div>
        <div>
            <a href="/admin/dashboard"><i class="fas fa-home"></i> Dashboard</a>
            <a href="/admin/services" class="active"><i class="fas fa-briefcase"></i> Services</a>
            <a href="/admin/team"><i class="fas fa-users"></i> Team</a>
            <a href="/admin/inquiries"><i class="fas fa-envelope"></i> Inquiries</a>
            <hr class="bg-secondary">
            <a href="/"><i class="fas fa-globe"></i> View Website</a>
            <a href="/admin/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </nav>

    <main class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>
                <%= title %>
            </h2>
            <a href="/admin/services/add" class="btn btn-success"><i class="fas fa-plus"></i> Add New Service</a>
        </div>

        <div class="card">
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Slug</th>
                            <th>Status</th>
                            <th>Order</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% services.forEach(service=> { %>
                            <tr>
                                <td><strong>
                                        <%= service.title %>
                                    </strong></td>
                                <td><code><%= service.slug %></code></td>
                                <td>
                                    <% if (service.is_active) { %>
                                        <span class="badge bg-success">Active</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary">Inactive</span>
                                            <% } %>
                                </td>
                                <td>
                                    <%= service.sort_order %>
                                </td>
                                <td>
                                    <a href="/admin/services/edit/<%= service.id %>" class="btn btn-sm btn-primary">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <form method="POST" action="/admin/services/delete/<%= service.id %>"
                                        style="display:inline">
                                        <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Delete this service?')">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>