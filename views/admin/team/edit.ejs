<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - Admin
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Summernote CSS/JS -->
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>
    <style>
        body {
            background: #f8f9fa;
        }

        .sidebar {
            min-height: 100vh;
            background: #212529;
            position: fixed;
            width: 250px;
        }

        .sidebar a {
            color: #adb5bd;
            padding: 10px 20px;
            display: block;
            text-decoration: none;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #343a40;
            color: #fff;
        }

        .main-content {
            margin-left: 250px;
            padding: 20px;
        }

        .image-preview {
            max-width: 200px;
            max-height: 200px;
            margin-top: 10px;
            border-radius: 8px;
        }
    </style>
</head>

<body>
    <nav class="sidebar">
        <div class="p-3">
            <h5 class="text-white">Admin Panel</h5>
            <p class="text-muted small">Welcome, admin</p>
        </div>
        <div>
            <a href="/admin/dashboard"><i class="fas fa-home"></i> Dashboard</a>
            <a href="/admin/services"><i class="fas fa-briefcase"></i> Services</a>
            <a href="/admin/team" class="active"><i class="fas fa-users"></i> Team</a>
            <a href="/admin/inquiries"><i class="fas fa-envelope"></i> Inquiries</a>
            <a href="/admin/settings"><i class="fas fa-cog"></i> Website Settings</a>
            <hr class="bg-secondary">
            <a href="/"><i class="fas fa-globe"></i> View Website</a>
            <a href="/admin/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </nav>

    <main class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="fas fa-edit"></i>
                <%= title %>
            </h2>
            <a href="/admin/team" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back to Team</a>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h5>Team Member Details</h5>
                    </div>
                    <div class="card-body">
                        <form action="/admin/team/edit/<%= member.id %>" method="POST" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label class="form-label">Name *</label>
                                <input type="text" name="name" class="form-control" value="<%= member.name %>" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Role/Position *</label>
                                <input type="text" name="role" class="form-control" value="<%= member.role %>" required>
                                <small class="text-muted">e.g., Senior Attorney, Partner, Legal Consultant</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Bio</label>
                                <textarea name="bio" id="bio" class="form-control"
                                    rows="4"><%= member.bio || '' %></textarea>
                                <small class="text-muted">Brief description about this team member</small>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Email</label>
                                        <input type="email" name="email" class="form-control"
                                            value="<%= member.email || '' %>" placeholder="contact@example.com">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Phone</label>
                                        <input type="text" name="phone" class="form-control"
                                            value="<%= member.phone || '' %>" placeholder="+1234567890">
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Areas of Practice</label>
                                <input type="text" name="practice_areas" class="form-control"
                                    value="<%= member.practice_areas || '' %>"
                                    placeholder="Corporate Law, Litigation, Family Law">
                                <small class="text-muted">Separate multiple areas with commas</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Profile Image</label>
                                <input type="file" name="image" class="form-control" accept="image/*" id="imageInput">
                                <small class="text-muted">Upload a profile photo (JPG, PNG, max 2MB)</small>
                                <% if (member.image) { %>
                                    <div class="mt-2">
                                        <img src="<%= member.image %>" alt="Current image" class="image-preview"
                                            id="currentImage">
                                        <p class="text-muted small">Current image</p>
                                    </div>
                                    <% } %>
                                        <img id="imagePreview" class="image-preview" style="display: none;">
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Sort Order</label>
                                        <input type="number" name="sort_order" class="form-control"
                                            value="<%= member.sort_order %>" min="0">
                                        <small class="text-muted">Lower numbers appear first</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Status</label>
                                        <div class="form-check form-switch">
                                            <input type="checkbox" name="is_active" class="form-check-input" id="active"
                                                <%=member.is_active ? 'checked' : '' %>>
                                            <label class="form-check-label" for="active">Active (visible on
                                                website)</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <hr>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-save"></i> Save Changes
                                </button>
                                <a href="/admin/team" class="btn btn-outline-secondary btn-lg">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6><i class="fas fa-info-circle"></i> Tips</h6>
                    </div>
                    <div class="card-body">
                        <ul class="small">
                            <li>Use professional headshot photos</li>
                            <li>Recommended image size: 400x400px</li>
                            <li>Keep bio concise (2-3 sentences)</li>
                            <li>Sort order determines display order on website</li>
                            <li>Uncheck "Active" to hide without deleting</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Image preview
        document.getElementById('imageInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const preview = document.getElementById('imagePreview');
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    const current = document.getElementById('currentImage');
                    if (current) current.style.display = 'none';
                }
                reader.readAsDataURL(file);
            }
        });

        // Initialize Summernote
        $(document).ready(function () {
            $('#bio').summernote({
                placeholder: 'Enter bio here...',
                tabsize: 2,
                height: 300,
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'underline', 'clear']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['table', ['table']],
                    ['insert', ['link', 'picture', 'video']],
                    ['view', ['fullscreen', 'codeview', 'help']]
                ]
            });
        });
    </script>
</body>

</html>