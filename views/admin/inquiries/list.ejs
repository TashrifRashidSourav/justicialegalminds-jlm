<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - Admin
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: #f8f9fa;
        }

        .sidebar {
            min-height: 100vh;
            background: #212529;
            position: fixed;
            width: 250px;
        }

        .sidebar a {
            color: #adb5bd;
            padding: 10px 20px;
            display: block;
            text-decoration: none;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #343a40;
            color: #fff;
        }

        .main-content {
            margin-left: 250px;
            padding: 20px;
        }
    </style>
</head>

<body>
    <nav class="sidebar">
        <div class="p-3">
            <h5 class="text-white">Admin Panel</h5>
            <p class="text-muted small">Welcome, admin</p>
        </div>
        <div>
            <a href="/admin/dashboard"><i class="fas fa-home"></i> Dashboard</a>
            <a href="/admin/services"><i class="fas fa-briefcase"></i> Services</a>
            <a href="/admin/team"><i class="fas fa-users"></i> Team</a>
            <a href="/admin/inquiries" class="active"><i class="fas fa-envelope"></i> Inquiries</a>
            <hr class="bg-secondary">
            <a href="/"><i class="fas fa-globe"></i> View Website</a>
            <a href="/admin/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </nav>

    <main class="main-content">
        <h2>
            <%= title %>
        </h2>

        <div class="card mt-4">
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Subject</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% inquiries.forEach(inquiry=> { %>
                            <tr class="<%= inquiry.is_read ? '' : 'table-warning' %>">
                                <td>
                                    <%= inquiry.name %>
                                </td>
                                <td>
                                    <%= inquiry.email %>
                                </td>
                                <td>
                                    <%= inquiry.subject || 'N/A' %>
                                </td>
                                <td>
                                    <%= new Date(inquiry.created_at).toLocaleDateString() %>
                                </td>
                                <td>
                                    <% if (inquiry.is_read) { %>
                                        <span class="badge bg-secondary">Read</span>
                                        <% } else { %>
                                            <span class="badge bg-warning">Unread</span>
                                            <% } %>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-info" data-bs-toggle="modal"
                                        data-bs-target="#modal<%= inquiry.id %>">
                                        <i class="fas fa-eye"></i> View
                                    </button>
                                    <% if (!inquiry.is_read) { %>
                                        <form method="POST" action="/admin/inquiries/read/<%= inquiry.id %>"
                                            style="display:inline">
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="fas fa-check"></i> Mark Read
                                            </button>
                                        </form>
                                        <% } %>
                                            <form method="POST" action="/admin/inquiries/delete/<%= inquiry.id %>"
                                                style="display:inline">
                                                <button type="submit" class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Delete?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                </td>
                            </tr>

                            <!-- Modal -->
                            <div class="modal fade" id="modal<%= inquiry.id %>">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Inquiry from <%= inquiry.name %>
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p><strong>Email:</strong>
                                                <%= inquiry.email %>
                                            </p>
                                            <p><strong>Phone:</strong>
                                                <%= inquiry.phone || 'N/A' %>
                                            </p>
                                            <p><strong>Subject:</strong>
                                                <%= inquiry.subject || 'N/A' %>
                                            </p>
                                            <p><strong>Message:</strong></p>
                                            <p>
                                                <%= inquiry.message %>
                                            </p>
                                            <p><strong>Date:</strong>
                                                <%= new Date(inquiry.created_at).toLocaleString() %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>