<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - Admin
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: #f8f9fa;
        }

        .sidebar {
            min-height: 100vh;
            background: #212529;
            position: fixed;
            width: 250px;
        }

        .sidebar a {
            color: #adb5bd;
            padding: 10px 20px;
            display: block;
            text-decoration: none;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #343a40;
            color: #fff;
        }

        .main-content {
            margin-left: 250px;
            padding: 20px;
        }
    </style>
</head>

<body>
    <nav class="sidebar">
        <div class="p-3">
            <h5 class="text-white">Admin Panel</h5>
            <p class="text-muted small">Welcome, <%= user.username %>
            </p>
        </div>
        <div>
            <a href="/admin/dashboard" class="<%= currentPage === 'dashboard' ? 'active' : '' %>"><i
                    class="fas fa-home"></i> Dashboard</a>
            <a href="/admin/services" class="<%= currentPage === 'services' ? 'active' : '' %>"><i
                    class="fas fa-briefcase"></i> Services</a>
            <a href="/admin/team" class="<%= currentPage === 'team' ? 'active' : '' %>"><i class="fas fa-users"></i>
                Team</a>
            <a href="/admin/inquiries" class="<%= currentPage === 'inquiries' ? 'active' : '' %>"><i
                    class="fas fa-envelope"></i> Inquiries</a>
            <hr class="bg-secondary">
            <a href="/"><i class="fas fa-globe"></i> View Website</a>
            <a href="/admin/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </nav>

    <main class="main-content">
        <% if (success && success.length> 0) { %>
            <div class="alert alert-success alert-dismissible fade show">
                <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>
                <% if (error && error.length> 0) { %>
                    <div class="alert alert-danger alert-dismissible fade show">
                        <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% } %>

                        <%- body %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>