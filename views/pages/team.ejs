<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>

<body class="bg-gray-50">
    <%- include('../partials/header') %>

        <section class="py-20 bg-gray-50">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h1 class="text-4xl md:text-5xl font-bold font-serif text-gray-900 mb-4">Meet Our Experts</h1>
                    <p class="text-xl text-gray-600 max-w-2xl mx-auto">Dedicated professionals committed to your legal
                        success.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    <% team.forEach(member=> { %>
                        <div
                            class="group bg-white rounded-xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
                            <div class="relative overflow-hidden aspect-[4/5] bg-gray-200">
                                <% if (member.image) { %>
                                    <img src="<%= member.image %>" alt="<%= member.name %>"
                                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                                    <% } else { %>
                                        <div
                                            class="w-full h-full flex items-center justify-center text-6xl text-gray-400 bg-gray-100">
                                            <i class="fas fa-user-tie"></i>
                                        </div>
                                        <% } %>

                                            <a href="/team/<%= member.id %>"
                                                class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/0 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-6">
                                                <span
                                                    class="text-white text-sm font-medium tracking-wide uppercase hover:underline">View
                                                    Profile</span>
                                            </a>
                            </div>

                            <div class="p-6 text-center">
                                <h3
                                    class="text-xl font-bold text-gray-900 mb-1 group-hover:text-primary transition-colors">
                                    <a href="/team/<%= member.id %>">
                                        <%= member.name %>
                                    </a>
                                </h3>
                                <div class="h-1 w-12 bg-primary mx-auto mb-3 rounded-full"></div>
                                <p class="text-sm font-semibold text-gray-600 uppercase tracking-wider mb-4">
                                    <%= member.role %>
                                </p>
                                <% if (member.bio) { %>
                                    <!-- Strip HTML tags for the summary card -->
                                    <p class="text-gray-500 text-sm line-clamp-3 leading-relaxed">
                                        <%= member.bio.replace(/<[^>]*>?/gm, '') %>
                                    </p>
                                    <% } %>
                            </div>
                        </div>
                        <% }) %>
                </div>
            </div>
        </section>

        <%- include('../partials/footer') %>
            <script src="/js/main.js"></script>
</body>

</html>