<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-gray-50">
    <%- include('../partials/header') %>

        <!-- Hero Section -->
        <section class="py-20"
            style="background-color: <%= heroData.backgroundColor %>; background-image: url('<%= heroData.backgroundImage %>'); background-size: cover; background-position: center;">
            <div class="container mx-auto px-6 text-center">
                <h1 class="text-4xl md:text-6xl font-bold font-serif mb-6" style="color: <%= heroData.textColor %>">
                    <%= heroData.title %>
                </h1>
                <p class="text-xl md:text-2xl mb-8" style="color: <%= heroData.subtitleColor %>">
                    <%= heroData.subtitle %>
                </p>
                <a href="<%= heroData.buttonLink %>"
                    class="px-8 py-3 rounded-lg font-bold hover:opacity-90 transition inline-block"
                    style="background-color: <%= heroData.buttonColor %>; color: <%= heroData.buttonTextColor %>">
                    <%= heroData.buttonText %>
                </a>
            </div>
        </section>

        <!-- Services Preview -->
        <section class="py-20">
            <div class="container mx-auto px-6">
                <h2 class="text-3xl md:text-4xl font-bold font-serif text-center mb-12">Our Services</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <% services.forEach(service=> { %>
                        <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition">
                            <div class="text-primary text-4xl mb-4">⚖️</div>
                            <h3 class="text-xl font-bold mb-3">
                                <%= service.title %>
                            </h3>
                            <p class="text-gray-600 mb-4">
                                <%= service.description || 'Expert legal services' %>
                            </p>
                            <a href="/services" class="text-primary font-bold hover:underline">Learn More →</a>
                        </div>
                        <% }) %>
                </div>
                <div class="text-center mt-12">
                    <a href="/services"
                        class="bg-gray-900 text-white px-8 py-3 rounded-lg font-bold hover:bg-gray-800 transition">View
                        All Services</a>
                </div>
            </div>
        </section>

        <%- include('../partials/footer') %>
            <script src="/js/main.js"></script>
</body>

</html>