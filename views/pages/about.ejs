<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-gray-50">
    <%- include('../partials/header') %>

        <section class="py-20">
            <div class="container mx-auto px-6">
                <h1 class="text-4xl md:text-5xl font-bold font-serif text-center mb-12">About Us</h1>

                <div class="max-w-4xl mx-auto">
                    <div class="bg-white p-8 rounded-lg shadow-lg mb-8">
                        <h2 class="text-2xl font-bold mb-4">Who We Are</h2>
                        <p class="text-gray-700 mb-4">
                            Justicia Legal Minds is a team of experienced legal professionals dedicated to providing
                            exceptional legal services.
                            Our commitment to excellence and client satisfaction sets us apart.
                        </p>
                        <p class="text-gray-700">
                            With years of combined experience, we handle complex legal matters with expertise,
                            integrity, and dedication to justice.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="bg-white p-6 rounded-lg shadow-lg text-center">
                            <div class="text-primary text-4xl mb-3">✔️</div>
                            <h3 class="font-bold text-xl mb-2">Expert Attorneys</h3>
                            <p class="text-gray-600">Highly qualified legal professionals</p>
                        </div>
                        <div class="bg-white p-6 rounded-lg shadow-lg text-center">
                            <div class="text-primary text-4xl mb-3">🏆</div>
                            <h3 class="font-bold text-xl mb-2">98% Success Rate</h3>
                            <p class="text-gray-600">Proven track record of success</p>
                        </div>
                        <div class="bg-white p-6 rounded-lg shadow-lg text-center">
                            <div class="text-primary text-4xl mb-3">💼</div>
                            <h3 class="font-bold text-xl mb-2">Transparent Pricing</h3>
                            <p class="text-gray-600">No hidden fees, honest costs</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <%- include('../partials/footer') %>
            <script src="/js/main.js"></script>
</body>

</html>