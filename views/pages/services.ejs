<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-gray-50">
    <%- include('../partials/header') %>

        <section class="py-20">
            <div class="container mx-auto px-6">
                <h1 class="text-4xl md:text-5xl font-bold font-serif text-center mb-12">Our Services</h1>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <% services.forEach(service=> { %>
                        <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition">
                            <div class="text-primary text-5xl mb-4">⚖️</div>
                            <h3 class="text-2xl font-bold mb-3">
                                <%= service.title %>
                            </h3>
                            <p class="text-gray-600 mb-4">
                                <%= service.description || 'Expert legal services tailored to your needs' %>
                            </p>
                            <a href="/contact"
                                class="bg-primary text-white px-6 py-2 rounded-lg font-bold hover:bg-opacity-90 transition inline-block">Get
                                Started</a>
                        </div>
                        <% }) %>
                </div>
            </div>
        </section>

        <%- include('../partials/footer') %>
            <script src="/js/main.js"></script>
</body>

</html>